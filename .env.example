# GitHub OAuth
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback

# JWT RSA keys (paste PEM, replacing actual newlines with \n)
# Generate with:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
#   awk 'NF {sub(/\r/, ""); printf "%s\\n",$0;}' private.pem
JWT_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----

# Database (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/auth_db

# CORS / Frontend
FRONTEND_URL=http://localhost:3000

# Cookie / state signing (min 32 chars)
SECRET_KEY=replace-this-with-a-long-random-secret-key

# Optional overrides
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=true
DEBUG=false

# Google Gemini (required for chat streaming)
# Get your key at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-gemini-api-key-here
